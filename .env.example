# =========================
# HospAI Backend
# =========================

# Server
PORT=5001
CORS_ALLOWED_ORIGINS=https://app.hospai.ai,https://staging-app.hospai.ai,http://localhost:5173,http://127.0.0.1:5173
FLASK_ENV=production

# Session auth
SESSION_COOKIE_NAME=hospai_session
SESSION_TTL_HOURS=12
SESSION_PEPPER=change-this-to-a-long-random-secret
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# =========================
# /admin Separate Route Auth
# =========================
# REQUIRED to enable /admin login challenge.
ADMIN_ROUTE_PASSWORD=change-this-admin-route-password

# Optional overrides
ADMIN_ROUTE_AUTH_COOKIE_NAME=hospai_admin_route_auth
ADMIN_ROUTE_AUTH_TTL_SECONDS=3600
ADMIN_ROUTE_AUTH_SECRET=change-this-admin-route-cookie-secret

# =========================
# Platform Admin (cross-hospital superadmin, /platform-admin)
# =========================
# Leave blank to disable the platform-admin login entirely.
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=

# =========================
# Database
# =========================
DATABASE_URL=postgresql://hospai:hospai_local_dev@host.docker.internal:5434/hospai
DEFAULT_HOSPITAL_CODE=hosp-default

# Only used by docker-compose's bundled `postgres` service to initialize
# its own container; irrelevant if DATABASE_URL points at an external/managed
# Postgres (e.g. Neon) instead.
POSTGRES_DB=hospai
POSTGRES_USER=hospai
POSTGRES_PASSWORD=change-this-postgres-password

# Connection pool size (backend + celery-worker each maintain their own pool)
PG_POOL_MIN=1
PG_POOL_MAX=4

# =========================
# OCR / AI
# =========================
# Local vLLM is preferred for OCR/AI mode when available. AI_PROVIDER accepts
# "vllm", "gemini", or "ollama". (LLM_PROVIDER is accepted as an alias.)
AI_PROVIDER=vllm
VLLM_BASE_URL=http://host.docker.internal:8700/v1
VLLM_MODEL=qwen2.5-vl-7b
VLLM_API_KEY=local
VLLM_EMBEDDING_MODEL=
VLLM_TIMEOUT_SECONDS=60

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# Optional Gemini fallback. Leave empty when using local vLLM.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_DIM=768

# =========================
# Symptom AI (symptom_backend/ — separate Flask service, Gemini-only)
# =========================
# Dedicated key so this service's quota is isolated from the main backend's
# GEMINI_API_KEY. Falls back to GEMINI_API_KEY / GOOGLE_API_KEY if unset.
SYMPTOM_AI_GEMINI_API_KEY=
SYMPTOM_AI_MODEL=gemini-flash-latest
SYMPTOM_AI_MIN_REQUEST_INTERVAL=

# =========================
# Object Storage (Optional)
# =========================
# If blank, app falls back to local uploads/. BUCKET_NAME is the primary
# variable name; S3_BUCKET / S3_BUCKET_NAME / AWS_S3_BUCKET are accepted
# aliases for the same value (set only one).
BUCKET_URL=
BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=
S3_VIRTUAL_HOSTED=false

# =========================
# Frontend build args (set in frontend/.env or root .env; consumed by
# frontend/Dockerfile as build ARGs, embedded at build time)
# =========================
VITE_API_BASE=
VITE_API_URL=
VITE_SYMPTOM_API_BASE=
VITE_OCR_PORTAL_URL=

# Login/register pages redirect to this URL after submit.
VITE_APP_URL=http://localhost:5173

# =========================
# Razorpay (Backend)
# =========================
# Use test keys in staging/dev and live keys in production.
# Example:
# RAZORPAY_KEY_ID=rzp_live_xxxxxxx
# RAZORPAY_KEY_SECRET=4r5xxxxxxxxxxxxxxxxxxx3t
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# =========================
# WhatsApp (Twilio)
# =========================
# Leave blank to disable WhatsApp notifications entirely (sends are skipped
# and logged, never raise errors). TWILIO_WHATSAPP_FROM must be a
# WhatsApp-enabled Twilio sender number in E.164 format, WITHOUT the
# "whatsapp:" prefix (the code adds it). PUBLIC_BASE_URL is required only for
# messages that attach a PDF (e.g. the prescription), since Twilio's servers
# fetch the media over the open internet and can't reach localhost.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
PUBLIC_BASE_URL=
WHATSAPP_DEFAULT_COUNTRY_CODE=+91

# =========================
# WhatsApp (Meta Cloud API — alternate integration, backend/modules/whatsapp)
# =========================
# Independent of the Twilio integration above; only needed if using Meta's
# WhatsApp Business Cloud API directly instead of Twilio.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
