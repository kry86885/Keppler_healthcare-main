# =========================
# HospAI Backend
# =========================

# Server
PORT=5001
CORS_ALLOWED_ORIGINS=https://app.hospai.ai,https://staging-app.hospai.ai,http://localhost:5173,http://127.0.0.1:5173

# Session auth
SESSION_COOKIE_NAME=hospai_session
SESSION_TTL_HOURS=12
SESSION_PEPPER=change-this-to-a-long-random-secret
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# =========================
# /admin Separate Route Auth
# =========================
# REQUIRED to enable /admin login challenge.
ADMIN_ROUTE_PASSWORD=change-this-admin-route-password

# Optional overrides
ADMIN_ROUTE_AUTH_COOKIE_NAME=hospai_admin_route_auth
ADMIN_ROUTE_AUTH_TTL_SECONDS=3600
ADMIN_ROUTE_AUTH_SECRET=change-this-admin-route-cookie-secret

# =========================
# Database
# =========================
DATABASE_URL=postgresql://hospai:hospai_local_dev@host.docker.internal:5434/hospai

# =========================
# OCR / AI
# =========================
# Local vLLM is preferred for OCR/AI mode when available.
AI_PROVIDER=vllm
VLLM_BASE_URL=http://host.docker.internal:8700/v1
VLLM_MODEL=qwen2.5-vl-7b
VLLM_API_KEY=local
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# Optional Gemini fallback. Leave empty when using local vLLM.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# =========================
# Object Storage (Optional)
# =========================
# If blank, app falls back to local uploads/
BUCKET_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=

# =========================
# Frontend (set in frontend/.env if needed)
# =========================
# VITE_API_BASE=http://localhost:5001
# VITE_SYMPTOM_API_BASE=http://localhost:5002

# =========================
# Static Marketing Site
# =========================
# Login/register pages redirect to this URL after submit.
VITE_APP_URL=http://localhost:5173

# =========================
# Razorpay (Backend)
# =========================
# Use test keys in staging/dev and live keys in production.
# Example:
# RAZORPAY_KEY_ID=rzp_live_xxxxxxx
# RAZORPAY_KEY_SECRET=4r5xxxxxxxxxxxxxxxxxxx3t
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# =========================
# WhatsApp (Twilio)
# =========================
# Leave blank to disable WhatsApp notifications entirely (sends are skipped
# and logged, never raise errors). TWILIO_WHATSAPP_FROM must be a
# WhatsApp-enabled Twilio sender number in E.164 format, WITHOUT the
# "whatsapp:" prefix (the code adds it). PUBLIC_BASE_URL is required only for
# messages that attach a PDF (e.g. the prescription), since Twilio's servers
# fetch the media over the open internet and can't reach localhost.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
PUBLIC_BASE_URL=
WHATSAPP_DEFAULT_COUNTRY_CODE=+91
