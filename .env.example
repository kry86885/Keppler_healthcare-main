# =========================
# HospAI Backend
# =========================

# Server
PORT=5001
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com
# Gunicorn worker count (backend) and Postgres connection pool size per
# process -- raise WEB_CONCURRENCY for more concurrent request throughput,
# but keep PG_POOL_MAX * WEB_CONCURRENCY under your Postgres max_connections.
WEB_CONCURRENCY=50
PG_POOL_MAX=4
# Publicly reachable HTTPS origin of this backend (e.g. https://api.yourdomain.com,
# no trailing slash). Required only for WhatsApp messages that attach a PDF
# (prescription notifications, EMR "Share via WhatsApp") -- Twilio's servers
# fetch the attachment over the open internet, so this can't be localhost.
# Leave blank to disable PDF attachments; text-only WhatsApp sends still work.
PUBLIC_BASE_URL=

# Re-seeds 4 well-known demo accounts (admin/Admin@123, employee/employee123,
# staff/staff123, doctor/doctor123) on every backend startup, resetting their
# password and reactivating them even if you've since changed/disabled them.
# Fine for local/demo use. Set to false for any real deployment.
SEED_DEMO_USERS=true

# Required to store secrets entered through the admin Settings screen (e.g.
# the WhatsApp Business/Twilio API key added via Settings -> WhatsApp
# Business API) encrypted at rest, instead of setting TWILIO_* below directly.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up -- losing it makes previously-saved secrets undecryptable.
SETTINGS_ENCRYPTION_KEY=

# Session auth
SESSION_COOKIE_NAME=hospai_session
SESSION_TTL_HOURS=12
SESSION_PEPPER=change-this-to-a-long-random-secret
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# =========================
# /admin Separate Route Auth
# =========================
ADMIN_ROUTE_PASSWORD=change-this-admin-route-password
ADMIN_ROUTE_AUTH_COOKIE_NAME=hospai_admin_route_auth
ADMIN_ROUTE_AUTH_TTL_SECONDS=3600
ADMIN_ROUTE_AUTH_SECRET=change-this-admin-route-cookie-secret

# =========================
# Database (CONFIGURED FOR POSTGRESQL)
# =========================
DB_ENGINE=postgres
DB_PATH=
POSTGRES_DB=hospai
POSTGRES_USER=hospai
POSTGRES_PASSWORD=hospai_secure_password
DATABASE_URL=postgresql://hospai:hospai_secure_password@postgres:5432/hospai

# =========================
# OCR / AI
# =========================
# Local vLLM only -- no cloud LLM provider, and no Ollama, is used anywhere in this app.
AI_PROVIDER=vllm
# Must be reachable from inside the backend/symptom-backend containers. If vLLM runs
# on the same host as Docker, host.docker.internal usually works (mapped via
# extra_hosts in docker-compose.yml) -- if not, use that host's actual LAN IP instead.
VLLM_BASE_URL=http://host.docker.internal:8700/v1
VLLM_MODEL=qwen2.5-vl-7b
VLLM_API_KEY=local

# =========================
# Object Storage (Optional)
# =========================
BUCKET_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=

# =========================
# Frontend build args
# =========================
# For single-domain deployment behind a reverse proxy (like Traefik), set VITE_API_BASE
# and VITE_SYMPTOM_API_BASE to empty strings (""). This configures React to make same-origin
# relative API calls (/api/... and /api/symptom-ai/...), requiring zero localhost references or CORS.
VITE_API_BASE=http://localhost:5011
VITE_SYMPTOM_API_BASE=http://localhost:5002

# =========================
# Razorpay (Backend)
# =========================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# =========================
# WhatsApp / Twilio (Optional)
# =========================
# Prefer configuring this through the app instead: log in as an owner/admin
# and go to Settings -> WhatsApp Business API. That's stored encrypted in the
# database (see SETTINGS_ENCRYPTION_KEY above) and takes effect immediately,
# no redeploy needed, and takes priority over these if both are set. These
# env vars are only a server-level fallback for when nothing's been saved
# through Settings yet.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_DEFAULT_COUNTRY_CODE=+91
