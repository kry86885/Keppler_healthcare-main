FROM python:3.11-slim

WORKDIR /app/ocr_portal

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# xhtml2pdf needs build-essential/pkg-config/libcairo2-dev; cv2 (via
# ultralytics/opencv-python-headless) needs libGL.so.1/libglib even in the
# "headless" package.
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    pkg-config \
    libcairo2-dev \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY ocr_portal/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 7620

CMD ["sh", "-c", "alembic upgrade head && uvicorn api.main:app --host 0.0.0.0 --port 7620 --reload"]
