{
  "blueprint_version": "1.0",
  "title": "Inpatient Case Study Summary",
  "rendering_rules": {
    "missing_value_placeholder": "—",
    "missing_checkbox_placeholder": "☐ (not recorded)",
    "checkbox_checked": "☑",
    "checkbox_unchecked": "☐",
    "always_render_every_field": true,
    "never_drop_empty_sections": true,
    "note": "Every field defined here is ALWAYS rendered. If the OCR/extraction did not find a value, the field is shown with the missing-value placeholder instead of being omitted. This guarantees a fixed, comparable structure across all patients."
  },
  "field_types": {
    "text": "Free text or single value (e.g. name, date, dose).",
    "number": "Numeric value, optional unit.",
    "checkbox": "Single Yes/No / ticked state -> ☑ or ☐.",
    "checklist": "Group of labelled checkbox items, each with its own state.",
    "score": "A scored assessment item with value and band/category.",
    "table": "Repeating rows with fixed columns.",
    "narrative": "Multi-sentence clinical prose."
  },

  "sections": [
    {
      "id": "patient_identification",
      "title": "1. Patient Identification & Admission",
      "source_forms": ["Ophthalmology Case Sheet", "Admission Record Sheet", "Discharge/MRD Sheet"],
      "fields": [
        {"key": "patient_name", "label": "Patient Name", "type": "text"},
        {"key": "age", "label": "Age", "type": "text"},
        {"key": "sex", "label": "Sex", "type": "text"},
        {"key": "ip_no", "label": "IP No.", "type": "text"},
        {"key": "umr_no", "label": "UMR No.", "type": "text"},
        {"key": "address", "label": "Address", "type": "text"},
        {"key": "guardian_name", "label": "S/o · D/o · W/o", "type": "text"},
        {"key": "contact_number", "label": "Contact Number", "type": "text"},
        {"key": "ward_bed", "label": "Ward / Bed", "type": "text"},
        {"key": "department_unit", "label": "Department / Unit", "type": "text"},
        {"key": "treating_doctor", "label": "Treating Doctor / Consultant", "type": "text"},
        {"key": "treating_nurse", "label": "Treating Nurse / Staff", "type": "text"},
        {"key": "admission_date", "label": "Date of Admission", "type": "text"},
        {"key": "discharge_date", "label": "Date of Discharge", "type": "text"},
        {"key": "hospital_days", "label": "No. of Hospital Days", "type": "text"},
        {"key": "admission_type", "label": "Admission Type", "type": "checklist",
         "items": ["Concession", "Insurance", "Paid", "Dr.NTR", "EHS", "Teaching"]},
        {"key": "government_employee", "label": "Government Employee", "type": "checkbox"},
        {"key": "re_admitted", "label": "Re-admitted", "type": "checkbox"},
        {"key": "mlc", "label": "MLC (Medico-Legal Case)", "type": "checkbox"},
        {"key": "blood_group", "label": "Blood Group", "type": "text"}
      ]
    },
    {
      "id": "diagnosis",
      "title": "2. Diagnosis & Reason for Admission",
      "source_forms": ["Admission Record Sheet", "Nurses Notes", "Nursing Care Plan"],
      "fields": [
        {"key": "presenting_complaint", "label": "Presenting Complaint", "type": "text"},
        {"key": "working_diagnosis", "label": "Working / Pre-op Diagnosis", "type": "text"},
        {"key": "final_diagnosis", "label": "Final Diagnosis", "type": "table",
         "columns": ["#", "Diagnosis", "ICD Code"]},
        {"key": "secondary_diagnoses", "label": "Secondary Diagnoses / Co-morbidities", "type": "text"}
      ]
    },
    {
      "id": "allergies",
      "title": "3. Allergies & Alerts",
      "source_forms": ["Initial Assessment", "Treatment Chart", "ISBAR Handover"],
      "fields": [
        {"key": "drug_allergy", "label": "Medication / Drug Allergy", "type": "checkbox", "capture_detail": true},
        {"key": "food_allergy", "label": "Food Allergy", "type": "checkbox", "capture_detail": true},
        {"key": "blood_transfusion_allergy", "label": "Blood Transfusion Reaction", "type": "checkbox", "capture_detail": true},
        {"key": "other_allergies", "label": "Other Allergies", "type": "text"},
        {"key": "high_alert_medication", "label": "On High-Alert Medication", "type": "checkbox"}
      ]
    },
    {
      "id": "procedure",
      "title": "4. Surgery / Procedure & Pre-operative Checklist",
      "source_forms": ["Ophthalmology Pre-Operative Checklist", "Admission Record Sheet"],
      "fields": [
        {"key": "planned_procedure", "label": "Planned Procedure / Surgery", "type": "text"},
        {"key": "operative_eye_site", "label": "Operative Eye / Site", "type": "text"},
        {"key": "iol_power", "label": "IOL Power", "type": "text"},
        {"key": "surgeon", "label": "Surgeon", "type": "text"},
        {"key": "procedure_date", "label": "Procedure Date", "type": "text"},
        {"key": "preop_checklist", "label": "Pre-operative Checklist", "type": "checklist_kv",
         "items": [
           {"key": "dilatation", "label": "Dilatation"},
           {"key": "viral_markers", "label": "Viral Markers"},
           {"key": "bp", "label": "BP"},
           {"key": "fbs_rbs", "label": "FBS / RBS"},
           {"key": "preop_vision", "label": "Pre-op Vision"},
           {"key": "iop", "label": "IOP"},
           {"key": "consent", "label": "Consent"},
           {"key": "xylocaine_test", "label": "Xylocaine Test"},
           {"key": "rop_las_syringing", "label": "ROP LAS / Syringing"}
         ]},
        {"key": "intra_op_complications", "label": "Intra-operative Complications", "type": "text"}
      ]
    },
    {
      "id": "medications",
      "title": "5. Treatment / Medication Chart",
      "source_forms": ["Treatment Chart"],
      "fields": [
        {"key": "plan_of_care_change", "label": "Change in Plan of Care", "type": "text"},
        {"key": "medication_table", "label": "Medications", "type": "table",
         "columns": ["Date", "Drug Name", "Dose", "Route", "Frequency"]}
      ]
    },
    {
      "id": "vitals_labs",
      "title": "6. Vital Signs & Investigations",
      "source_forms": ["Initial Assessment", "MEWS Chart", "Nurses Notes", "Inpatient Investigations"],
      "fields": [
        {"key": "vitals_on_admission", "label": "Vitals on Admission", "type": "checklist_kv",
         "items": [
           {"key": "temp", "label": "Temperature"},
           {"key": "pulse", "label": "Pulse / HR"},
           {"key": "resp_rate", "label": "Respiratory Rate"},
           {"key": "bp", "label": "Blood Pressure"},
           {"key": "spo2", "label": "SpO2"},
           {"key": "height", "label": "Height"},
           {"key": "weight", "label": "Weight"}
         ]},
        {"key": "mews_total", "label": "MEWS Total Score", "type": "score"},
        {"key": "investigations", "label": "Investigations / Labs", "type": "table",
         "columns": ["Investigation", "Advised Date", "Result", "Reported Date"]}
      ]
    },
    {
      "id": "risk_assessments",
      "title": "7. Risk Assessment Scores",
      "source_forms": ["Braden Scale", "Morse Fall Risk Scale", "Pain Assessment", "Patient Acuity Scoring"],
      "fields": [
        {"key": "fall_risk_morse", "label": "Fall Risk (Morse)", "type": "score", "bands": ["Low 0-24", "Moderate 25-44", "High >45"]},
        {"key": "pressure_sore_braden", "label": "Pressure Sore Risk (Braden)", "type": "score", "bands": ["Severe <9", "High 10-12", "Mild 13-14", "Low 15-18"]},
        {"key": "pain_score", "label": "Pain Score (0-10)", "type": "score"},
        {"key": "acuity_score", "label": "Patient Acuity Score", "type": "score", "bands": ["Minor 0-6 (I)", "Moderate 7-19 (II)", "Major 20+ (III)"]}
      ]
    },
    {
      "id": "nursing_assessment",
      "title": "8. Nursing Assessment (Initial)",
      "source_forms": ["Initial Assessment by Staff Nurse", "Nutritional Status"],
      "fields": [
        {"key": "received_mode", "label": "Received Patient As", "type": "checklist", "items": ["Walking", "Wheelchair", "Stretcher"]},
        {"key": "orientation", "label": "Oriented", "type": "checkbox"},
        {"key": "speech", "label": "Speech", "type": "checklist", "items": ["Normal", "Slurred"]},
        {"key": "adl_independent", "label": "ADLs Independent", "type": "checkbox"},
        {"key": "respiration", "label": "Respiration Pattern", "type": "text"},
        {"key": "gastrointestinal", "label": "Gastrointestinal", "type": "text"},
        {"key": "bowel", "label": "Bowel", "type": "text"},
        {"key": "bladder", "label": "Bladder", "type": "text"},
        {"key": "skin", "label": "Skin", "type": "text"},
        {"key": "sleeping_pattern", "label": "Sleeping Pattern", "type": "text"},
        {"key": "appetite", "label": "Appetite", "type": "text"},
        {"key": "mode_of_intake", "label": "Mode of Intake", "type": "text"},
        {"key": "coping_mechanism", "label": "Coping Mechanism", "type": "text"},
        {"key": "language_spoken", "label": "Language Spoken", "type": "text"},
        {"key": "prior_medication_history", "label": "Previous / Home Medication", "type": "text"}
      ]
    },
    {
      "id": "patient_education",
      "title": "9. Patient / Family Education Checklist",
      "source_forms": ["Check List Tool for Patient Education"],
      "fields": [
        {"key": "education_items", "label": "Education Provided", "type": "checklist",
         "items": [
           "Identification Band", "Hand Hygiene / Visitor Instructions",
           "Food & Drug Interactions", "Patient Rights & Responsibilities",
           "Orientation to Room / Facilities", "Visiting Time / Instructions",
           "Pain Management Education"
         ]},
        {"key": "educated_by", "label": "Educated By (Nurse)", "type": "text"},
        {"key": "education_datetime", "label": "Date / Time", "type": "text"}
      ]
    },
    {
      "id": "fall_prevention",
      "title": "10. Fall Prevention Intervention Bundle",
      "source_forms": ["Fall Prevention Intervention Bundle"],
      "fields": [
        {"key": "applicable_risk_level", "label": "Applicable Risk Level", "type": "text"},
        {"key": "interventions_applied", "label": "Interventions Applied", "type": "checklist",
         "items": [
           "Call bell within reach", "Fall-risk education given",
           "Bed in lowest position, brakes locked", "Side rails raised",
           "Advised on postural hypotension", "Advised on medication/sedation effects",
           "Non-compliance documented"
         ]}
      ]
    },
    {
      "id": "care_plan",
      "title": "11. Nursing Care Plan",
      "source_forms": ["Nursing Care Plan"],
      "fields": [
        {"key": "care_plan_table", "label": "Care Plan", "type": "table",
         "columns": ["Assessment / Focus", "Diagnosis", "Intervention", "Rationale", "Evaluation"]}
      ]
    },
    {
      "id": "clinical_course",
      "title": "12. Clinical Course & Nurses' Notes",
      "source_forms": ["Nurses Notes", "MEWS Chart"],
      "fields": [
        {"key": "course_narrative", "label": "Clinical Course Narrative", "type": "narrative"},
        {"key": "shift_events", "label": "Shift Events", "type": "table",
         "columns": ["Date", "Time", "Event / Note", "Recorded By"]}
      ]
    },
    {
      "id": "handover",
      "title": "13. Handover (ISBAR) & Patient Movement",
      "source_forms": ["ISBAR Handover", "Patient Movement (Shifting) Information"],
      "fields": [
        {"key": "patient_complaints", "label": "Patient Complaints", "type": "checkbox"},
        {"key": "vitals_unstable", "label": "Vital Signs Unstable", "type": "checkbox"},
        {"key": "fall_risk_handover", "label": "Fall Risk", "type": "text"},
        {"key": "skin_integrity_checked", "label": "Skin Integrity Check Done", "type": "checkbox"},
        {"key": "patient_movement", "label": "Patient Movement", "type": "table",
         "columns": ["Shifted From", "Shifted To", "Handed Over By", "Taken Over By", "Date", "Time"]}
      ]
    },
    {
      "id": "outcome",
      "title": "14. Outcome / Disposition",
      "source_forms": ["Admission Record Sheet", "Discharge/MRD Sheet"],
      "fields": [
        {"key": "result", "label": "Result", "type": "checklist", "items": ["Cured", "Relieved", "Otherwise", "Death"]},
        {"key": "discharge_disposition", "label": "Discharge / Disposition", "type": "text"},
        {"key": "discharge_advice", "label": "Discharge Advice / Follow-up", "type": "text"}
      ]
    },
    {
      "id": "data_quality",
      "title": "15. Data Quality & Provenance",
      "source_forms": ["auto-generated"],
      "fields": [
        {"key": "pages_processed", "label": "Pages Processed", "type": "text"},
        {"key": "fields_captured", "label": "Fields Captured", "type": "text"},
        {"key": "fields_blank", "label": "Fields Left Blank (not found)", "type": "text"},
        {"key": "low_confidence_fields", "label": "Low-confidence / Verify Manually", "type": "text"}
      ]
    }
  ]
}
