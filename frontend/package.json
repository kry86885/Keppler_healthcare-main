{
  "name": "hospai-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Keppler Healthcare frontend desktop app",
  "author": "Keppler Healthcare",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "cross-env CI=true vite --host 127.0.0.1",
    "dev:alt": "cross-env CI=true vite --host 127.0.0.1 --port 6173",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "electron:dev:alt": "concurrently -k \"vite --port 6173\" \"wait-on tcp:6173 && electron . --port=6173\"",
    "electron:pack": "vite build && electron-builder --dir",
    "electron:build": "vite build && electron-builder --win nsis --mac dmg --linux AppImage deb",
    "electron:build:win": "vite build && electron-builder --win nsis",
    "electron:build:mac": "vite build && electron-builder --mac dmg",
    "electron:build:linux": "vite build && electron-builder --linux AppImage",
    "electron:build:deb": "vite build && electron-builder --linux deb",
    "test": "vitest",
    "test:run": "vitest run",
    "test:payments": "vitest run src/lib/razorpay.test.ts src/pages/RazorpayFlows.test.tsx src/pages/BillingPage.test.tsx src/pages/OpPage.test.tsx src/pages/RegistrationDeskPage.test.tsx",
    "test:ui": "vitest --ui",
    "test:e2e": "NODE_OPTIONS='--unhandled-rejections=warn' E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:5173} jest --config ./jest.config.cjs",
    "test:e2e:headed": "NODE_OPTIONS='--unhandled-rejections=warn' HEADLESS=false E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:5173} jest --config ./jest.config.cjs",
    "test:e2e:artifacts": "NODE_OPTIONS='--unhandled-rejections=warn' E2E_RUN_ID=latest E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:5173} jest --config ./jest.config.cjs",
    "test:e2e:video": "node ./tests/e2e/make-video.cjs ./tests/e2e/artifacts/latest ./tests/e2e/artifacts/latest/e2e-run.mp4"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "jest": "^29.7.0",
    "jest-puppeteer": "^10.1.0",
    "jsdom": "^25.0.1",
    "puppeteer": "^24.5.0",
    "typescript": "^5.8.2",
    "vite": "^5.4.0",
    "vitest": "^4.0.18",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.keppler.healthcare",
    "productName": "Keppler Healthcare",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.medical"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}