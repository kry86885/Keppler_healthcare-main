#!/usr/bin/env bash
# Blocks a commit if any staged file appears to contain a live API key/secret.
# Install: cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
set -euo pipefail

PATTERNS=(
  'AIza[0-9A-Za-z_-]{35}'                 # Google API key (Gemini, Maps, etc.)
  'AQ\.[0-9A-Za-z_-]{30,}'                 # Google OAuth/newer-format API key
  'sk-[A-Za-z0-9]{20,}'                    # OpenAI/Anthropic-style secret key
  'AKIA[0-9A-Z]{16}'                       # AWS access key ID
  'ya29\.[0-9A-Za-z_-]+'                   # Google OAuth access token
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'     # PEM private key
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED_FILES" ] && exit 0

found=0
for pattern in "${PATTERNS[@]}"; do
  while IFS= read -r file; do
    [ -f "$file" ] || continue
    # Never flag .env.example / templates that only declare empty placeholders.
    case "$file" in *.env.example) continue ;; esac
    if git diff --cached -- "$file" | grep -E -o "$pattern" >/dev/null 2>&1; then
      echo "BLOCKED: possible secret matching /$pattern/ staged in: $file"
      found=1
    fi
  done <<< "$STAGED_FILES"
done

if [ "$found" -ne 0 ]; then
  echo
  echo "Commit aborted: a staged file looks like it contains a live API key or secret."
  echo "If this is a false positive, use 'git commit --no-verify' to bypass."
  exit 1
fi

exit 0
