.#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORTS=("5011" "5002" "5173")
RUN_DIR="${ROOT_DIR}/.devrun"
BACKEND_VENV="${ROOT_DIR}/.venv-backend"
BACKEND_LOG="${RUN_DIR}/backend.log"
FRONTEND_LOG="${RUN_DIR}/frontend.log"
SYMPTOM_LOG="${RUN_DIR}/symptom-backend.log"
BACKEND_PID_FILE="${RUN_DIR}/backend.pid"
FRONTEND_PID_FILE="${RUN_DIR}/frontend.pid"
SYMPTOM_PID_FILE="${RUN_DIR}/symptom-backend.pid"
BACKEND_PID=""
FRONTEND_PID=""
SYMPTOM_PID=""

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  echo "Usage: ./startdev"
  echo "Starts HospAI backend + symptom backend + Electron app locally (no Docker/Podman)."
  echo "Backend: python backend/app.py (Flask debug reload)"
  echo "Symptom backend: python symptom_backend/app.py (Flask debug reload)"
  echo "Desktop app: npm run electron:dev (Vite + Electron)"
  exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "Error: python3 is not installed or not in PATH."
  exit 1
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "Error: npm is not installed or not in PATH."
  exit 1
fi

for port in "${PORTS[@]}"; do
  pids="$(lsof -t -iTCP:"${port}" -sTCP:LISTEN 2>/dev/null || true)"
  if [[ -n "${pids}" ]]; then
    echo "Cleaning up process listening on port ${port}..."
    kill -9 ${pids} 2>/dev/null || true
    for _ in {1..10}; do
      if ! lsof -t -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1; then
        break
      fi
      sleep 0.3
    done
  fi
done

mkdir -p "${RUN_DIR}"
touch "${BACKEND_LOG}" "${FRONTEND_LOG}" "${SYMPTOM_LOG}"

if [[ ! -d "${ROOT_DIR}/frontend/node_modules" ]]; then
  echo "Installing frontend dependencies..."
  (cd "${ROOT_DIR}/frontend" && npm install)
fi

if [[ ! -d "${BACKEND_VENV}" ]]; then
  echo "Creating backend virtual environment..."
  python3 -m venv "${BACKEND_VENV}"
fi

echo "Installing backend dependencies..."
"${BACKEND_VENV}/bin/pip" install -r "${ROOT_DIR}/backend/requirements.txt"
echo "Installing symptom backend dependencies..."
"${BACKEND_VENV}/bin/pip" install -r "${ROOT_DIR}/symptom_backend/requirements.txt"

MAIN_DB_STARTED=false

cleanup() {
  echo
  echo "Stopping dev services..."
  if [[ -n "${FRONTEND_PID}" ]] && kill -0 "${FRONTEND_PID}" 2>/dev/null; then
    kill "${FRONTEND_PID}" 2>/dev/null || true
  fi
  if [[ -n "${BACKEND_PID}" ]] && kill -0 "${BACKEND_PID}" 2>/dev/null; then
    kill "${BACKEND_PID}" 2>/dev/null || true
  fi
  if [[ -n "${SYMPTOM_PID}" ]] && kill -0 "${SYMPTOM_PID}" 2>/dev/null; then
    kill "${SYMPTOM_PID}" 2>/dev/null || true
  fi
  rm -f "${BACKEND_PID_FILE}" "${FRONTEND_PID_FILE}" "${SYMPTOM_PID_FILE}"
  # main-postgres deliberately left running on cleanup -- it holds the app's
  # persistent local data, and stopping it on every Ctrl+C would defeat the
  # point of it being a real durable DB.
  wait 2>/dev/null || true
}

trap cleanup INT TERM EXIT

if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
  echo "Starting local Postgres (main app DB) via Docker..."
  if (cd "${ROOT_DIR}" && docker compose -f docker-compose.dev.yml up -d main-postgres); then
    MAIN_DB_STARTED=true
  else
    echo "Warning: failed to start main-postgres. The backend will fail to connect unless DATABASE_URL/DB_ENGINE point elsewhere."
  fi
else
  echo "Docker not available: skipping local Postgres. Set DB_ENGINE=sqlite or point DATABASE_URL at a reachable Postgres."
fi

# NOTE: these are intentionally NOT wrapped in `( ... )` subshells. A
# background job started inside a `(...)` subshell belongs to that subshell's
# job table, not this script's -- once the subshell exits (immediately after
# backgrounding it), the process is orphaned from this shell's perspective.
# `$!`/PID-file writes still "worked" but the PID was never a real child of
# this shell, so the `wait` at the bottom of this script returned instantly
# instead of blocking, `cleanup()` couldn't actually kill anything by PID, and
# this script printed "Stopping dev services..." right after "started" even
# though the (now-orphaned, still-running) nohup'd processes lived on --
# extremely easy to mistake for a crash and re-run, piling up duplicate
# backend/frontend processes fighting over the same ports.
echo "Starting backend..."
cd "${ROOT_DIR}/backend"
CORS_ALLOWED_ORIGINS="${CORS_ALLOWED_ORIGINS:-http://localhost:5173,http://127.0.0.1:5173}" \
PORT="${BACKEND_PORT:-5011}" \
FLASK_ENV=development \
SESSION_COOKIE_SECURE=false \
nohup "${BACKEND_VENV}/bin/python" app.py \
  > >(tee -a "${BACKEND_LOG}") \
  2> >(tee -a "${BACKEND_LOG}" >&2) &
BACKEND_PID=$!
echo "${BACKEND_PID}" > "${BACKEND_PID_FILE}"
cd "${ROOT_DIR}"

echo "Starting symptom backend..."
cd "${ROOT_DIR}/symptom_backend"
PORT="${SYMPTOM_PORT:-5002}" \
FLASK_ENV=development \
nohup "${BACKEND_VENV}/bin/python" app.py \
  > >(tee -a "${SYMPTOM_LOG}") \
  2> >(tee -a "${SYMPTOM_LOG}" >&2) &
SYMPTOM_PID=$!
echo "${SYMPTOM_PID}" > "${SYMPTOM_PID_FILE}"
cd "${ROOT_DIR}"

echo "Starting frontend..."
cd "${ROOT_DIR}/frontend"
VITE_API_BASE="${VITE_API_BASE:-http://localhost:5011}" \
VITE_API_URL="${VITE_API_URL:-http://localhost:5011}" \
VITE_SYMPTOM_API_BASE="${VITE_SYMPTOM_API_BASE:-http://localhost:${SYMPTOM_PORT:-5002}}" \
CHOKIDAR_USEPOLLING=true \
WATCHPACK_POLLING=true \
nohup npm run dev -- --host \
  > >(tee -a "${FRONTEND_LOG}") \
  2> >(tee -a "${FRONTEND_LOG}" >&2) &
FRONTEND_PID=$!
echo "${FRONTEND_PID}" > "${FRONTEND_PID_FILE}"
cd "${ROOT_DIR}"

echo
echo "Dev services started:"
echo "Backend PID:  ${BACKEND_PID}"
echo "Symptom PID:  ${SYMPTOM_PID}"
echo "Frontend PID: ${FRONTEND_PID}"
echo "Backend log:  ${BACKEND_LOG}"
echo "Symptom log:  ${SYMPTOM_LOG}"
echo "Frontend log: ${FRONTEND_LOG}"

echo
echo "Frontend: http://localhost:5173"
echo "Backend:  http://localhost:${BACKEND_PORT:-5011}"
echo "Symptom:  http://localhost:${SYMPTOM_PORT:-5002}"
if [[ "${MAIN_DB_STARTED}" == "true" ]]; then
  echo "Main DB:  local Postgres on localhost:5434 (docker container, not shared with the team)"
fi
echo "Web app: running on all network interfaces"

wait
